{% extends "layouts/base.html" %}
{% load static %}
{% load home_formatos %}
{% block content %}
    {% load humanize %}
    {% comment %} {% get_Rurais value item.imovel as rurais %} {% endcomment %}
    {% comment %} {% get_Rurais_Nomes value item.imovel as rurais_nomes %} {% endcomment %}
    <div class="card" id="card_real">
        <div class="card-header">
            <h5>
                Indicador Real - {{ item.tipo|get_descricao_tipo_registro }}:
                <span class="font-weight-bold f-26 {% if item.encerrado == 'F' %}text-white {% else %}text-white bg-danger{% endif %}">
                    {{ item.numero|formatar_numero_registro }}
                </span>
                <span class="font-weight f-18 text-light">CNM:</span>
                <span class="font-weight-bold f-26 text-white">{{ item.cnm }}</span>
            </h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-4">
                    Municipio: <b>{{ item.municipio }}</b>
                </div>
                <div class="col-4">
                    Data Abertura: <b>{{ item.data_abertura|date:"d/m/y" }}</b>
                </div>
                <div class="col-4"></div>
            </div>
            <div class="row mb-3">
                <div class="col-4">
                    Cadastro Municipal: <b>{{ item.imovel.numeros_contribuinte }}</b>
                </div>
                <div class="col-4">
                    {% if item.classe == 'R' %}
                        {% for lote in lotes %}
                            <!-- VERIFICAR Tipo de Construcao -->
                            {% get_tipo_construcao_lote value lote.residencial lote.comercial as tipo_construcao %}
                            Tipo de Construção: <b> {{ tipo_construcao }} </b>
                        {% endfor %}
                    {% endif %}
                </div>
                <div class="col-4">
                    Registro Encerrado:
                    <span class="font-weight-bold {% if item.encerrado == 'F' %}text-dark{% else %}text-danger{% endif %}">
                    {{ item.encerrado|formatar_tipo_encerramento }}</span>
                </div>
            </div>
            {% if item.classe == 'R' %}
                <div class="row mb-3">
                    <div class="col-4">
                        {% for rurais_nomes in rurais_nomes %}Fazenda: <b>{{ rurais_nomes.nome }}</b>{% endfor %}
                    </div>
                    <div class="col-4">
                        {% for rurais in rurais %}Caracteristica: <b>{{ rurais.caracteristica }}</b>{% endfor %}
                    </div>
                    <div class="col-4"></div>
                    <div class="col-4"></div>
                </div>
                <div class="row mb-3">
                    <div class="col-4">
                        {% for rurais in rurais %}Área: <b>{{ rurais.area }}</b>{% endfor %}
                    </div>
                    <div class="col-4">
                        NIRF: <b>{{ item.numero_nirf }}</b>
                    </div>
                    <div class="col-4">
                        CCIR: <b>{{ item.numero_ccirr }}</b>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-4">
                        CAR: <b>{{ item.numero_car }}</b>
                    </div>
                    <div class="col-4">
                        GEO: <b>{{ item.numero_incra }}</b>
                    </div>
                    <div class="col-4"></div>
                </div>
                <div class="row mb-3">
                    <div class="col-4">
                        ITR: <b>{{ item.numero_itr|default:"" }}</b>
                    </div>
                    <div class="col-4">
                        Validade do ITR: <b>{{ item.data_validade_itr|naturalday|converter_data_para_formato_de_modelo }}</b>
                    </div>
                    <div class="col-4"></div>
                </div>
            {% else %}
                {% for lote in lotes %}
                    <div class="row mb-3">
                        <div class="col-4">
                            Bairro: <b>{{ lote.setor }}</b>
                        </div>
                        <div class="col-4">
                            Quadra: <b>{{ lote.quadra }}</b>
                        </div>
                        <div class="col-4">
                            Lote: <b>{{ lote.numero_unidade }}</b>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-8">
                            Rua: <b>{{ lote.unidade_id|get_nomes_das_ruas_pela_unidade }}</b>
                        </div>
                        <div class="col-4">
                            Área: <b>{{ lote.area }}</b>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4">
                            Área Residencial: <b>{{ item.area_construida_residencial|default:"" }}</b>
                        </div>
                        <div class="col-4">
                            Área de Construção: <b>{{ item.area_construida|default:"" }}</b>
                        </div>
                        <div class="col-4">
                            Área Comercial: <b>{{ item.area_construida_comercial|default:"" }}</b>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
    <div class="card" id="card_real_livro03">
        <div class="card-header text-white">
            Livro 3 (Vinculado ao Imóvel) <span class="badge bg-dark">{{ livro03_atual_quantidade }}</span>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Registro</th>
                        <th>Tipo de Cédula</th>
                        <th>Datas</th>
                        <th>Detalhes</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in livro03_atual %}
                        <tr>
                            <td>
                                {% comment %} Muda a cor do registro de acordo com a data de cancelamento.{% endcomment %}
                                {% if item.6  == "" %}
                                    <span class="btn btn-sm bg-danger activate text-white">
                                        <a class="text-white"
                                           title="Clique para Exibir dados completos do Registro: "
                                           href="{% url 'home:livro03_detail_pelo_numero' numero=item.numero cartorio=item.cartorio %}">{{ item.3 }}</a>
                                    </span>
                                {% else %}
                                    <span class="btn btn-sm bg-success activate text-white">
                                        <a class="text-white" title="Exibir dados completos do Registro: " {{ item.0 }} href="{% url 'home:livro03_detail_pelo_numero' numero=item.numero %}">
                                        {{ item.0 }}</a>
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="cell-content">{{ item.1 }} - Nº {{ item.2 }}</div>
                                <div class="cell-content">{{ item.7 }}</div>
                                <div class="cell-content">{{ item.3 }} Grau</div>
                                <div class="cell-content">Área Plantada: {{ item.8|default:"" }}</div>
                            </td>
                            <td>
                                <div class="cell-content">Abertura: {{ item.4 }}</div>
                                <div class="cell-content">Vencimento: {{ item.5 }}</div>
                                <div class="cell-content">
                                    Cancelamento: <b>{{ item.6 }}</b>
                                </div>
                            </td>
                            <td>
                                <a type="button"
                                   href="{% url 'home:livro03_texto_numero' numero_livro03=item.0|remover_pontuacao %}"
                                   target="_blank"
                                   aria-pressed="true"
                                   class="btn btn-sm btn-primary activate text-white">
                                    <i class="icon feather icon-file"></i> Ver Texto
                                </a>
                            </td>
                        </tr>
                        <!-- Linhas adicionais para itens envolvidos -->
                        {% for envolvidos in item.9 %}
                            <tr class="envolvido">
                                <td>{{ envolvidos.1|formatar_documento }}</td>
                                <td>{{ envolvidos.0 }}</td>
                                <td>
                                    {% if item.6 == '' %}
                                        {% if envolvidos.2 == "Avalista" %}
                                            <span class="badge bg-warning f-12">{{ envolvidos.2 }}</span>
                                        {% elif envolvidos.2 == "Devedor" %}
                                            <span class="badge bg-danger f-12">{{ envolvidos.2 }}</span>
                                        {% elif envolvidos.2 == "Credor" %}
                                            <span class="badge bg-primary f-12">{{ envolvidos.2 }}</span>
                                        {% else %}
                                            {{ envolvidos.2 }}
                                        {% endif %}
                                    {% else %}
                                        <div class="cell-content">{{ envolvidos.2 }}</div>
                                        <div class="cell-content">
                                            <span class="badge bg-success f-10">(BAIXADO:    {{ item.6 }})</span>
                                        </div>
                                    {% endif %}
                                </td>
                                <!-- Adicione mais células vazias aqui se quiser alinhar com o resto da tabela -->
                                <td colspan="5"></td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <a href="#card_real"
               class="btn btn-sm btn-warning text-dark "
               title="Retornar ao topo"
               type="button"
               data-bs-toggle="tooltip"><i class="icon feather icon-corner-left-up"></i>Voltar</a>
        </div>
    </div>
    {% if item.classe == 'L' %}
        {% if quantidade_de_unidades_no_condominio > 0 %}
            <div class="card" id="card_real_ficha_unidades_condominio">
                <div class="card-header text-white">
                    Unidade (Condominio)
                    <span class="badge bg-dark">{{ quantidade_de_unidades_no_condominio }}</span>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Edificio</th>
                                <th>Tipo de Unidade</th>
                                <th>Número da Unidade</th>
                                <th>Matrícula</th>
                                <th>Aréa</th>
                                <th>Data Cadastro</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <a href="#card_real"
                       class="btn btn-sm btn-warning text-dark "
                       title="Retornar ao topo"
                       type="button"
                       data-bs-toggle="tooltip"><i class="icon feather icon-corner-left-up"></i>Voltar</a>
                </div>
            </div>
        {% endif %}
        {% if loteamento_Quantidade > 0 %}
            <div class="card" id="card_real_ficha_unidades_loteamento">
                <div class="card-header text-white">
                    Unidade (Loteamento)
                    <span class="badge bg-dark">{{ loteamento_Quantidade }}</span>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Matrícula</th>
                                <th>Quadra</th>
                                <th>Lote</th>
                                <th>Bairro</th>
                                <th>Área</th>
                                <th>Ruas</th>
                                <th>Cadastro Municipal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!--
                            {% for item in loteamento %}
                                <tr>
                                    <td>{{ forloop.counter }}</td>
                                    <td>
                                        <span class="badge bg-primary f-14">
                                            <a class="text-white" title="Clique para acessar o Indicador Real." href="{% url 'home:livro04_imovel' item.unidade.imovel_id %}"  target="_blank">
                                                {{ item.unidade.imovel_id|get_numero_registro_pelo_id|formatar_numero_registro }}</span></a>
                                    </td>
                                    <td>{{ item.quadra }}</td>
                                    <td>{{ item.numero_unidade }}</td>
                                    <td>{{ item.setor }}</td>
                                    <td>{{ item.area }}</td>
                                    <td>
                                        {% for rua in item.unidade.id|retornar_ruas %}
                                            <div class="cell-content">
                                                <small>{{ rua.nome }}, {{ rua.numero_edificacao }}</small>
                                            </div>
                                        {% endfor %}
                                    </td>
                                    <td>{{ item.unidade.imovel.numeros_contribuinte }}</td>
                                </tr>
                            {% endfor %}
-->
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <a href="#card_real"
                       class="btn btn-sm btn-warning text-dark "
                       title="Retornar ao topo"
                       type="button"
                       data-bs-toggle="tooltip"><i class="icon feather icon-corner-left-up"></i>Voltar</a>
                </div>
            </div>
        {% endif %}
    {% endif %}
    {% if item.classe == 'C' %}
        <div class="card" id="card_real_condominio">
            <div class="card-header text-white">
                Condominio
                <span class="badge bg-dark">1</span>
            </div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Número</th>
                            <th>Condominio</th>
                            <th>Número</th>
                            <th>Incorporadora</th>
                            <th>Data Incorporação</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in item.registro_anterior|get_condominio_pelo_imovel %}
                            <tr>
                                <td>{{ item.0 }}</td>
                                <td>
                                    <span class="badge bg-primary f-14">
                                        <a class="text-white"
                                           title="Clique para acessar o Indicador Real."
                                           href="{% url 'home:livro04_detail' numero_registro=item.1|remover_pontuacao tipo_registro=item.0 cartorio_imovel=item.2 %}"
                                           target="_blank">
                                        {{ item.1|remover_pontuacao|formatar_numero_registro }}</span></a>
                                    </td>
                                    <td>{{ item.3 }}</td>
                                    <td>{{ item.6 }}</td>
                                    <td>{{ item.4 }}</td>
                                    <td>{{ item.5|date:"d/m/y" }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <a href="#card_real"
                       class="btn btn-sm btn-warning text-dark "
                       title="Retornar ao topo"
                       type="button"
                       data-bs-toggle="tooltip"><i class="icon feather icon-corner-left-up"></i>Voltar</a>
                </div>
            </div>
        {% endif %}
        {% if item.tipo_unidade == 'L' %}
            <div class="card" id="card_real_loteamento">
                <div class="card-header text-white">
                    Loteamento
                    <span class="badge bg-dark">1</span>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Número</th>
                                <th>Nome do Loteamento</th>
                                <th>Nome Incorporadora</th>
                                <th>Data de Registro</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in item.registro_anterior|get_loteamento_pelo_imovel %}
                                <tr>
                                    <td>{{ item.0 }}</td>
                                    <td>
                                        <span class="badge bg-primary f-14">
                                            <a class="text-white"
                                               title="Clique para acessar o Indicador Real."
                                               href="{% url 'home:livro04_detail' numero_registro=item.1|remover_pontuacao tipo_registro=item.0 cartorio_imovel=item.2 %}"
                                               target="_blank">
                                            {{ item.1|remover_pontuacao|formatar_numero_registro }}</span></a>
                                        </td>
                                        <td>{{ item.3 }}</td>
                                        <td>{{ item.4 }}</td>
                                        <td>{{ item.5|date:"d/m/y" }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer">
                        <a href="#card_real"
                           class="btn btn-sm btn-warning text-dark "
                           title="Retornar ao topo"
                           type="button"
                           data-bs-toggle="tooltip"><i class="icon feather icon-corner-left-up"></i>Voltar</a>
                    </div>
                </div>
            {% endif %}
        {% endblock %}
