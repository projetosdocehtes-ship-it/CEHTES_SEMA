@echo off
title Prime Django - Inicializacao

echo ================================
echo   INICIANDO PROJETO DJANGO
echo ================================

REM Ir para a pasta do projeto
cd /d C:\Cethes\CEHTES_SEMA\CEHTES_SEMA\AgenteIA\AgenteIA\prime-django

REM Verifica se o venv existe
if not exist venv\Scripts\activate (
    echo [ERRO] Virtualenv nao encontrado!
    pause
    exit /b
)

REM Ativar o ambiente virtual
call venv\Scripts\activate

REM Verifica se Django está instalado
python -m django --version >nul 2>&1
if errorlevel 1 (
    echo [ERRO] Django nao instalado no ambiente!
    echo Instalando dependencias...
    pip install -r requirements.txt
)

echo.
echo ================================
echo   SUBINDO SERVIDOR...
echo ================================

REM Rodar migrações
python manage.py migrate

REM Abrir navegador
start http://127.0.0.1:8001

REM Rodar servidor Django na porta 8001
python manage.py runserver 8001

pause